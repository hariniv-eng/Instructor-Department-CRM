{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=.env ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect:darwinbox": "tsx src/lib/connectors/inspect.ts darwinbox",
    "inspect:darwinbox-exits": "tsx src/lib/connectors/inspect.ts darwinbox-exits",
    "inspect:bigquery": "tsx src/lib/connectors/inspect.ts bigquery",
    "inspect:instructor-unit-completion": "tsx src/lib/connectors/inspect.ts instructor-unit-completion",
    "inspect:instructor-practice-exam": "tsx src/lib/connectors/inspect.ts instructor-practice-exam",
    "inspect:training-status-aggregation": "tsx src/lib/connectors/inspect.ts training-status-aggregation",
    "export:darwinbox": "tsx src/lib/connectors/export.ts darwinbox",
    "export:darwinbox-exits": "tsx src/lib/connectors/export.ts darwinbox-exits",
    "export:teachos": "tsx src/lib/connectors/export.ts teachos",
    "check:active-with-exit-date": "tsx src/lib/connectors/checkActiveWithExitDate.ts",
    "check:teachos-column": "tsx src/lib/connectors/checkColumnValues.ts",
    "check:instructor-learning-column": "tsx src/lib/connectors/checkInstructorLearningColumn.ts",
    "check:darwinbox-ids": "tsx src/lib/connectors/checkDarwinboxIds.ts",
    "reconcile:from-csv": "tsx src/scripts/reconcileFromCsv.ts",
    "check:capability-managers": "tsx src/scripts/checkCapabilityManagerCandidates.ts",
    "seed:app-users": "tsx src/scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.4",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.2"
  }
}
